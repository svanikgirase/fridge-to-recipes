# Copy this file to .env and fill in your real key.
# .env is in .gitignore, so it will never be committed.

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-key-here

# Optional: which Claude model to use (default: claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: port for the web UI (default: 3000)
# PORT=3000
